# gotor torrc 示例（客户端 + 洋葱服务）

SocksPort 9050
ControlPort 9051
DataDirectory /var/lib/gotor

# Control 认证（任选其一或组合）
# CookieAuthentication 1
# HashedControlPassword 16:...   # 由: gotor --hash-password 'secret'

Log notice stdout

# 路径约束（可选）
# ExitNodes {us}
# StrictNodes 0

# 洋葱服务托管（可选）
# HiddenServiceDir /var/lib/gotor/hs
# HiddenServicePort 80 127.0.0.1:8080

# 未知选项会被静默忽略（与 C Tor 客户端兼容策略一致）
